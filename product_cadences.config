# =============================================================================
# product_cadences.config
# =============================================================================
# Native cadences (in minutes) for each data product used by the
# COALITION-4 pipeline. validate_timestep.py reads this file to:
#   - validate the requested --step_minutes (must be >= the highest
#     non-null cadence below);
#   - derive per-product minute filters written to timestep_config.json.
#
# How to edit
# -----------
# Edit this file manually. Each entry under [cadences] is a key=value
# pair where the value is either:
#   - a positive integer (the product's native cadence in minutes), or
#   - the literal `null` (or an empty value) for continuous / event-based
#     products that have no fixed acquisition cadence. Lightning is the
#     canonical example: LINET strokes are observed events, not raster
#     scans, so the bin width follows whichever paired product the
#     experiment uses (radar / OPERA / most-common-cadence fallback).
#
# Inclusion / exclusion
# ---------------------
# Only the products listed here are considered active. To exclude a
# product from the current experiment (so its cadence does not raise
# the validator floor unnecessarily) comment it out with a leading `#`
# or remove the line entirely.
#
# Comments
# --------
# Lines beginning with `#` or `;` are comments and are ignored.

[cadences]
mtg                 = 10
lightning           = 10
opera_reflectivity  = 15
opera_rainfall_rate = 15
