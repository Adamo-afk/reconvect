# =============================================================================
# training.config
# =============================================================================
# Hyperparameters and run plan for train_models.py.
#
# How to use
# ----------
# Train every mode listed under [modes].run, in order, using one shared set
# of defaults:
#
#     python train_models.py --config training.config
#
# Override the run list from the command line (still reads everything else
# from this file):
#
#     python train_models.py --config training.config --mode mtg_opera_full
#
# Per-mode sections [mode.<name>] override any default in [defaults],
# [lr_schedule], or [early_stopping]. Anything omitted in a per-mode section
# is inherited.
#
# Available modes are listed in the docstring at the top of train_models.py.
# Lines beginning with `#` or `;` are comments.

# -----------------------------------------------------------------------------
# Which modes to train, in order
# -----------------------------------------------------------------------------

[modes]
# Comma-separated list. Every entry must be one of the modes registered in
# `TRAINING_MODES` (see the docstring of train_models.py). Modes that have
# no [mode.<name>] section below run with the unmodified defaults.
run = mtg_opera_radar_only, mtg_opera_mtgmr, mtg_opera_nwcsaf, mtg_opera_full

# -----------------------------------------------------------------------------
# Shared defaults
# -----------------------------------------------------------------------------

[defaults]
epochs           = 10
batch_size       = 8
dropout          = 0.1
norm             = layer        ; one of: none, batch, layer
seed             = 0
shuffle_buffer   = 256          ; samples held in RAM for shuffling
mixed_precision  = true         ; fp16 compute on tensor cores. Set false
                                ; only if fp16 underflow seems to be
                                ; triggering CUDA crashes.

# -----------------------------------------------------------------------------
# Cosine-with-warmup learning-rate schedule
# -----------------------------------------------------------------------------
# Phase 1 (epochs 0..warmup_epochs-1): linear ramp `min_lr -> initial_lr`.
# Phase 2 (remaining epochs):          cosine decay `initial_lr -> min_lr`.

[lr_schedule]
type          = cosine_warmup
initial_lr    = 1e-3
warmup_epochs = 6
min_lr        = 1e-6

# -----------------------------------------------------------------------------
# Early stopping
# -----------------------------------------------------------------------------
# Training stops when `monitor` does not improve by `min_delta` for `patience`
# consecutive epochs. With `restore_best_weights = true` the weights from the
# best epoch are reloaded before the model is saved (so the final saved
# model is always the best one, whether early stopping fired or training
# ran to `epochs`).

[early_stopping]
enabled              = true
monitor              = val_loss
mode                 = min     ; minimise the metric
patience             = 4
min_delta            = 1e-4
restore_best_weights = true

# -----------------------------------------------------------------------------
# Per-epoch resumable checkpoint
# -----------------------------------------------------------------------------
# After every epoch the script writes
# `models/checkpoints/<mode>_latest.keras` (model + optimizer state) and
# a `<mode>_latest.json` (next-epoch index). On a subsequent launch, if
# `resume = true` and a checkpoint exists, training picks up at that
# epoch instead of starting over. This is the safety net for the
# occasional "Windows fatal exception: access violation" CUDA crash —
# you lose at most one epoch of work, not the whole run.
#
# To force a fresh run regardless of checkpoint, either set `resume =
# false` here or pass `--fresh` on the command line.

[checkpointing]
enabled = true
resume  = true

# -----------------------------------------------------------------------------
# Per-mode overrides
# -----------------------------------------------------------------------------
# Add a [mode.<name>] section to override any default for a specific run.
# Common adjustments:
#   - lower `batch_size` for the heavier modes that have more channels;
#   - increase `epochs` for the harder targets if val_loss is still
#     improving when the run ends.

[mode.mtg_opera_radar_only]
# Lightest mode (OPERA + MTG vis_06 only). Defaults work as-is.

[mode.mtg_opera_mtgmr]
# Adds MTG IR/WV. Still light.

[mode.mtg_opera_nwcsaf]
# Adds NWCSAF on the LR branch. Marginally heavier.

[mode.mtg_opera_full]
# Full coalition: OPERA + MTG IR/WV + NWCSAF. Heaviest VRAM footprint.
# Inherits batch_size from [defaults] for consistency across the four
# Shapley modes — if you hit OOM on a smaller GPU, set
# `batch_size = <smaller>` here.
