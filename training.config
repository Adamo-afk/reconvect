# =============================================================================
# training.config
# =============================================================================
# Hyperparameters and run plan for train_models.py.
#
# How to use
# ----------
# Train every mode listed under [modes].run, in order, using one shared set
# of defaults:
#
#     python train_models.py --config training.config
#
# Override the run list from the command line (still reads everything else
# from this file):
#
#     python train_models.py --config training.config --mode mtg_opera_full
#
# Per-mode sections [mode.<name>] override any default in [defaults],
# [lr_schedule], or [early_stopping]. Anything omitted in a per-mode section
# is inherited.
#
# Available modes are listed in the docstring at the top of train_models.py.
# Lines beginning with `#` or `;` are comments.

# -----------------------------------------------------------------------------
# Which modes to train, in order
# -----------------------------------------------------------------------------

[modes]
# Comma-separated list. Every entry must be one of the modes registered in
# `TRAINING_MODES` (see the docstring of train_models.py). Modes that have
# no [mode.<name>] section below run with the unmodified defaults.
run = mtg_opera_radar_only, mtg_opera_mtgmr

# -----------------------------------------------------------------------------
# Shared defaults
# -----------------------------------------------------------------------------

[defaults]
epochs           = 20
batch_size       = 32
dropout          = 0.1
norm             = layer        ; one of: none, batch, layer
seed             = 0
shuffle_buffer   = 256          ; samples held in RAM for shuffling
mixed_precision  = true         ; fp16 compute on tensor cores. Set false
                                ; only if fp16 underflow seems to be
                                ; triggering CUDA crashes.

# -----------------------------------------------------------------------------
# Cosine-with-warmup learning-rate schedule
# -----------------------------------------------------------------------------
# Phase 1 (epochs 0..warmup_epochs-1): linear ramp `min_lr -> initial_lr`.
# Phase 2 (remaining epochs):          cosine decay `initial_lr -> min_lr`.

[lr_schedule]
type          = cosine_warmup
initial_lr    = 1e-3
warmup_epochs = 3
min_lr        = 1e-6

# -----------------------------------------------------------------------------
# Early stopping
# -----------------------------------------------------------------------------
# Training stops when `monitor` does not improve by `min_delta` for `patience`
# consecutive epochs. With `restore_best_weights = true` the weights from the
# best epoch are reloaded before the model is saved (so the final saved
# model is always the best one, whether early stopping fired or training
# ran to `epochs`).

[early_stopping]
enabled              = true
monitor              = val_loss
mode                 = min     ; minimise the metric
patience             = 6
min_delta            = 1e-5
restore_best_weights = true

# -----------------------------------------------------------------------------
# Per-epoch resumable checkpoint
# -----------------------------------------------------------------------------
# After every epoch the script writes
# `models/checkpoints/<mode>_latest.keras` (model + optimizer state) and
# a `<mode>_latest.json` (next-epoch index). On a subsequent launch, if
# `resume = true` and a checkpoint exists, training picks up at that
# epoch instead of starting over. This is the safety net for the
# occasional "Windows fatal exception: access violation" CUDA crash —
# you lose at most one epoch of work, not the whole run.
#
# To force a fresh run regardless of checkpoint, either set `resume =
# false` here or pass `--fresh` on the command line.

[checkpointing]
enabled = true
resume  = true

# -----------------------------------------------------------------------------
# Radar / OPERA multiclass loss
# -----------------------------------------------------------------------------
# Controls the loss used by radar modes (5-class rainfall rate). The
# default (weighting=none, gamma=0) keeps the historical plain
# CategoricalCrossentropy(label_smoothing=0.01) behaviour, so flipping
# nothing in this section reproduces older runs exactly.
#
# Opt in to focal+class-weighted CCE by setting weighting != none. The
# per-class prior is read from
# `our_data/opera_rainfall_fraction_<source>.json` produced by
# `python opera_rainfall_fraction.py --source <source>`. The two source
# tracks (dbscan / lightning) have separate priors because they sample
# different timesteps.
#
# weighting:
#   inverse  - alpha_k = 1 / (K * f_k)   ; normalized inverse-frequency
#   median   - alpha_k = median(f) / f_k ; median-frequency balancing
#                                          (gentler than 'inverse' when
#                                           the rarest class is very rare)
#   none     - alpha_k = 1               ; pure focal, no class weighting
#                                          (set gamma>0 for focal-only)
#
# gamma:     focal exponent; 0 disables focal modulation. Lightning side
#            uses 2.0; same default is reasonable here.
# alpha_max: clip to keep gradients stable. class 4 (>=40 mm/h) is so
#            sparse that inverse-frequency alpha can otherwise blow up
#            to ~1e4. 100 keeps the rarest class influential without
#            overwhelming the loss.
# label_smoothing: same as the legacy CCE call; prevents log(0) under
#                  mixed_float16 when the softmax saturates.

[radar_loss]
weighting       = median
gamma           = 2.0
alpha_max       = 100.0
label_smoothing = 0.01

# -----------------------------------------------------------------------------
# Domain-adaptation fine-tune (Swin head on top of a frozen backbone)
# -----------------------------------------------------------------------------
# Used when train_models.py runs with --stage finetune or --stage both.
# The base stage ignores this section. AdamW + cosine warmup are the
# standard recipe for fine-tuning a transformer head from scratch on
# top of frozen features.
#
# Swin head shape (window_size=8, n_swin_blocks=2): at the default
# 256x256 spatial input the head sees 1024 windows of 64 tokens each
# per Swin block, so the attention cost is O(B * 1024 * 64^2) per block
# - cheap compared to global self-attention. The 3 per-lead-time
# projection heads each add one Conv 1x1 + one final Conv 1x1.

[finetune]
optimizer      = adamw         ; adam | adamw
weight_decay   = 0.01
initial_lr     = 3e-4
warmup_epochs  = 3
min_lr         = 1e-6
epochs         = 20
window_size    = 8             ; Swin window size (must divide 256)
n_swin_blocks  = 2             ; total Swin blocks (block 0 = W-MSA, block 1 = SW-MSA)
num_heads      = 4
c_shared       = 64            ; channel width inside the head
head_dropout   = 0.1

# -----------------------------------------------------------------------------
# Per-mode overrides
# -----------------------------------------------------------------------------
# Add a [mode.<name>] section to override any default for a specific run.
# Common adjustments:
#   - lower `batch_size` for the heavier modes that have more channels;
#   - increase `epochs` for the harder targets if val_loss is still
#     improving when the run ends.

[mode.mtg_opera_radar_only]
# Lightest mode (OPERA + MTG vis_06 only). Defaults work as-is.

[mode.mtg_opera_mtgmr]
# Adds MTG IR/WV. Slightly heavier; inherits batch_size from [defaults].
# If you hit OOM on a smaller GPU, set `batch_size = <smaller>` here.
